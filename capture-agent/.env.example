# NCS Analyzer - Capture Agent Configuration
# Static settings only. Session credentials passed via CLI args in production.

# Laravel API base URL (no trailing slash)
NCS_API_URL=http://127.0.0.1:8000/api

# Capture sampling interval (seconds, default 1.0)
NCS_CAPTURE_INTERVAL=1.0

# Heartbeat interval (seconds, default 30.0)
NCS_HEARTBEAT_INTERVAL=30.0

# OCR engine: "none" (default), "tesseract", future: "paddleocr"
NCS_OCR_ENGINE=none

# Tesseract language (default: eng). Install: apt install tesseract-ocr tesseract-ocr-ind
NCS_OCR_LANG=eng

# Tesseract page segmentation mode (default: 6 = uniform block of text)
NCS_OCR_PSM=6

# Tesseract binary path. Resolution order: this var > PATH > C:\Program Files\Tesseract-OCR\tesseract.exe
# NCS_OCR_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- E2E testing only ---
# Production: browser downloads a fresh .bat via Dashboard (Download .bat button).
# The .bat sets NCS_API_URL (from server response) + NCS_SESSION_ID + NCS_API_TOKEN as env vars.
# NCS_SESSION_ID=
# NCS_API_TOKEN=
